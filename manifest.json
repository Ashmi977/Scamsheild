{
  "manifest_version": 3,
  "name": "ScamShield",
  "short_name": "ScamShield",
  "version": "1.3.0",
  "key": "",
  "description": "Offline, explainable scam check for SMS, WhatsApp, UPI, email, screenshots and QR codes. Nothing leaves your browser.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "contextMenus",
    "scripting",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://web.whatsapp.com/*",
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ScamShield: check a message",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open ScamShield"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self'"
  }
}
