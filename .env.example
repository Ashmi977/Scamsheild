# Copy these values into environment variables, or create config/scamshield.properties.
# The database is optional: analysis works without it.
SCAMSHIELD_DB_URL=jdbc:mysql://localhost:3306/scamshield?useSSL=false&serverTimezone=UTC
SCAMSHIELD_DB_USER=scamshield_user
SCAMSHIELD_DB_PASSWORD=replace_with_a_real_password
